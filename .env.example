# ServiceDesk Socket.IO Server Environment Configuration
# Copy this file to .env and configure according to your environment

# ===========================================
# Server Configuration
# ===========================================

# Server port (default: 3000)
PORT=3000

# Enable HTTPS (set to 'true' to enable, requires SSL certificates)
USE_HTTPS=false

# Environment (development, staging, production)
NODE_ENV=development

# ===========================================
# JWT Authentication
# ===========================================

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate a secure random string for production use
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===========================================
# Redis Configuration
# ===========================================

# Redis host
REDIS_HOST=127.0.0.1

# Redis port
REDIS_PORT=6379

# Redis password (leave empty if no auth required)
REDIS_PASSWORD=

# Redis database number (default: 0)
REDIS_DB=0

# ===========================================
# CORS Configuration
# ===========================================

# Allowed origins for CORS (use * for development, specific domains for production)
# Multiple origins: https://domain1.com,https://domain2.com
CORS_ORIGIN=*

# ===========================================
# SSL Configuration (if USE_HTTPS=true)
# ===========================================

# Path to SSL certificate file
SSL_CERT_PATH=./config/ssl/certificate.crt

# Path to SSL private key file
SSL_KEY_PATH=./config/ssl/private.key

# ===========================================
# Logging Configuration
# ===========================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable detailed logging (true/false)
DEBUG_MODE=false

# ===========================================
# Connection Configuration
# ===========================================

# Socket.IO ping timeout (milliseconds)
PING_TIMEOUT=60000

# Socket.IO ping interval (milliseconds)
PING_INTERVAL=25000

# Maximum unauthenticated connection time (milliseconds)
AUTH_TIMEOUT=30000

# ===========================================
# Security Configuration
# ===========================================

# Enable admin endpoints in production (NOT RECOMMENDED)
ENABLE_ADMIN_ENDPOINTS=false

# Maximum connections per user (0 = unlimited)
MAX_CONNECTIONS_PER_USER=0

# Rate limiting for authentication attempts
AUTH_RATE_LIMIT=10

# ===========================================
# Performance Configuration
# ===========================================

# Maximum HTTP buffer size for Socket.IO (bytes)
MAX_HTTP_BUFFER_SIZE=1048576

# Enable compression (true/false)
ENABLE_COMPRESSION=true

# Connection history size (number of events to keep)
CONNECTION_HISTORY_SIZE=100
