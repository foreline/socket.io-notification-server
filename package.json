{
  "name": "servicedesk-socketio-server",
  "version": "1.0.0",
  "description": "Socket.IO server for ServiceDesk real-time notifications with connection-specific JWT authentication",
  "main": "src/server.js",
  "scripts": {
    "start": "pm2 start ecosystem.config.js",
    "dev": "nodemon src/server.js",
    "stop": "pm2 stop all",
    "restart": "pm2 restart all",
    "logs": "pm2 logs",
    "debug:auth": "node -e \"const TokenGenerator = require('./src/utils/TokenGenerator'); new TokenGenerator().printTestTokens();\"",
    "debug:server": "nodemon src/server.js",
    "test:token": "node -e \"const TG = require('./src/utils/TokenGenerator'); const tg = new TG(); console.log('Test token:', tg.generateConnectionToken('test-user', 'test-conn'));\""
  },
  "dependencies": {
    "socket.io": "^4.7.2",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.6.7",
    "dotenv": "^16.3.1",
    "joi": "^17.9.2",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.9.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "socket.io",
    "jwt",
    "authentication",
    "real-time",
    "notifications",
    "servicedesk"
  ],
  "author": "ServiceDesk Team",
  "license": "MIT"
}
